{
  "cleanUrls": true,
  "trailingSlash": false,
  "routes": [
    { "src": "/paket/(?<slug>[^/]+)", "dest": "/paket-detail.html?slug=$slug" },
    { "src": "/paket-detail/(?<slug>[^/]+)", "dest": "/paket-detail.html?slug=$slug" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}
