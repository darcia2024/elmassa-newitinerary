{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/paket/:slug", "destination": "/paket-detail.html?slug=:slug" },
    { "source": "/paket-detail/:slug", "destination": "/paket-detail.html?slug=:slug" },
    { "source": "/paket-detail", "destination": "/paket-detail.html" }
  ]
}
